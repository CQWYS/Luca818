<script type="module">
import * as THREE from 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.module.js';


/* ========== ERROR HANDLING ========== */
const errorDisplay = document.getElementById('error-display');
function showError(msg) {
  errorDisplay.style.display = 'block';
  errorDisplay.textContent = msg;
}
window.addEventListener('error', (e) => {
  showError('Runtime Error: ' + e.message + '\nAt: ' + e.filename + ':' + e.lineno);
});
window.addEventListener('unhandledrejection', (e) => {
  showError('Unhandled Promise: ' + e.reason);
});

try {
/* ========== THREE.JS SCENE ========== */
const container = document.getElementById('canvas-container');
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x050505);
scene.fog = new THREE.Fog(0x050505, 100, 320);

const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 500);
const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
container.appendChild(renderer.domElement);

/* Lights - soft, gallery-like illumination on white */
const ambientLight = new THREE.AmbientLight(0xffffff, 0.45);
scene.add(ambientLight);
const dirLight = new THREE.DirectionalLight(0xffffff, 0.35);
dirLight.position.set(40, 60, 40);
dirLight.castShadow = true;
dirLight.shadow.mapSize.set(1024, 1024);
scene.add(dirLight);
const fillLight = new THREE.DirectionalLight(0xffffff, 0.18);
fillLight.position.set(-40, 25, -30);
scene.add(fillLight);
const backLight = new THREE.DirectionalLight(0xffffff, 0.10);
backLight.position.set(0, 15, -60);
scene.add(backLight);

/* Spherical layout parameters - generous spacing inspired by olafureliasson.net */
const cardW = 20;
const cardH = 15;
const radius = 72;
const flattenY = 0.38;
const depthVariation = 16;

const cards = [];
const textureLoader = new THREE.TextureLoader();
let loadedCount = 0;
const totalProjects = PROJECTS.length;

function checkAllLoaded() {
  loadedCount++;
  if (loadedCount >= totalProjects) {
    document.getElementById('loading').classList.add('hidden');
    setTimeout(() => { document.getElementById('hint').classList.add('hidden'); }, 6000);
  }
}

PROJECTS.forEach((proj, i) => {
  const geometry = new THREE.PlaneGeometry(cardW, cardH);
  let material;

  if (proj.cover) {
    const tex = textureLoader.load(
      'projects/' + proj.cover,
      () => checkAllLoaded(),
      undefined,
      () => checkAllLoaded()
    );
    tex.minFilter = THREE.LinearFilter;
    tex.magFilter = THREE.LinearFilter;
    material = new THREE.MeshStandardMaterial({
      map: tex,
      side: THREE.DoubleSide,
      roughness: 0.45,
      metalness: 0.02,
      color: 0xcccccc
    });
  } else {
    material = new THREE.MeshStandardMaterial({
      color: 0x333333,
      side: THREE.DoubleSide,
      roughness: 0.45
    });
    checkAllLoaded();
  }

  const mesh = new THREE.Mesh(geometry, material);
  mesh.userData = { project: proj, originalScale: 1 };
  mesh.castShadow = true;
  mesh.receiveShadow = true;

  /* Fibonacci sphere distribution with depth layering for spatial gallery feel */
  const phi = Math.acos(1 - 2 * (i + 0.5) / totalProjects);
  const theta = Math.PI * (1 + Math.sqrt(5)) * i;

  const depthOffset = Math.sin(i * 2.3 + 1.0) * depthVariation * 0.5;
  const r = radius + depthOffset;

  const x = r * Math.sin(phi) * Math.cos(theta);
  const y = r * Math.cos(phi) * flattenY;
  const z = r * Math.sin(phi) * Math.sin(theta);

  mesh.position.set(x, y, z);
  scene.add(mesh);
  cards.push(mesh);
});

/* Central sphere - minimal dark accent */
const sphereGeo = new THREE.SphereGeometry(2.8, 64, 64);
const sphereMat = new THREE.MeshStandardMaterial({
  color: 0xffffff,
  roughness: 0.35,
  metalness: 0.4
});
const sphere = new THREE.Mesh(sphereGeo, sphereMat);
sphere.position.set(0, 0, 0);
sphere.castShadow = true;
scene.add(sphere);

/* "I'm Luca" billboard label - minimal typographic accent */
function createLabelTexture() {
  const cvs = document.createElement('canvas');
  cvs.width = 512;
  cvs.height = 128;
  const ctx = cvs.getContext('2d');
  ctx.clearRect(0, 0, 512, 128);
  ctx.fillStyle = '#050505';
  ctx.font = '400 48px -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.letterSpacing = '4px';
  ctx.fillText("I'm Luca", 256, 64);
  return new THREE.CanvasTexture(cvs);
}

const labelTex = createLabelTexture();
labelTex.minFilter = THREE.LinearFilter;
const labelGeo = new THREE.PlaneGeometry(5, 1.25);
const labelMat = new THREE.MeshBasicMaterial({
  map: labelTex,
  transparent: true,
  opacity: 0.92,
  depthTest: false,
  side: THREE.DoubleSide
});
const labelMesh = new THREE.Mesh(labelGeo, labelMat);
labelMesh.position.set(0, 0, 2.4);
labelMesh.renderOrder = 10;
labelMesh.raycast = () => {};
scene.add(labelMesh);

/* Camera orbit - wider view for spacious gallery feel */
let camR = 115;
let camT = 0;
let camP = Math.PI / 2.15;
let targetT = 0;
let targetP = Math.PI / 2.15;
let isDragging = false;
let lastMX = 0, lastMY = 0;

function updateCamera() {
  camera.position.x = camR * Math.sin(camP) * Math.cos(camT);
  camera.position.y = camR * Math.cos(camP);
  camera.position.z = camR * Math.sin(camP) * Math.sin(camT);
  camera.lookAt(0, 0, 0);
}
updateCamera();

/* Raycaster */
const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2(-99, -99);
let hoveredCard = null;
let hoveredSphere = false;
let mouseX = 0, mouseY = 0;

const tooltip = document.getElementById('tooltip');
const tooltipTag = document.getElementById('tooltip-tag');
const tooltipTitle = document.getElementById('tooltip-title');
const tooltipCount = document.getElementById('tooltip-count');

function onPointerMove(e) {
  const cx = e.clientX !== undefined ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : 0);
  const cy = e.clientY !== undefined ? e.clientY : (e.touches && e.touches[0] ? e.touches[0].clientY : 0);
  mouse.x = (cx / window.innerWidth) * 2 - 1;
  mouse.y = -(cy / window.innerHeight) * 2 + 1;
  mouseX = cx;
  mouseY = cy;
  if (isDragging) {
    const dx = cx - lastMX;
    const dy = cy - lastMY;
    targetT -= dx * 0.005;
    targetP += dy * 0.005;
    targetP = Math.max(0.3, Math.min(Math.PI - 0.3, targetP));
    lastMX = cx;
    lastMY = cy;
  }
}

function onPointerDown(e) {
  isDragging = true;
  const cx = e.clientX !== undefined ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : 0);
  const cy = e.clientY !== undefined ? e.clientY : (e.touches && e.touches[0] ? e.touches[0].clientY : 0);
  lastMX = cx;
  lastMY = cy;
}

function onPointerUp() {
  isDragging = false;
}

function onWheel(e) {
  camR += e.deltaY * 0.06;
  camR = Math.max(55, Math.min(200, camR));
}

window.addEventListener('mousemove', onPointerMove);
window.addEventListener('mousedown', onPointerDown);
window.addEventListener('mouseup', onPointerUp);
window.addEventListener('touchmove', (e) => {
  if (e.touches.length === 1) {
    onPointerMove(e);
  }
}, { passive: false });
window.addEventListener('touchstart', (e) => {
  if (e.touches.length === 1) {
    onPointerDown(e);
  }
}, { passive: false });
window.addEventListener('touchend', onPointerUp);
window.addEventListener('wheel', onWheel, { passive: false });

/* Click */
window.addEventListener('click', (e) => {
  if (isDragging && (Math.abs(e.clientX - lastMX) > 4 || Math.abs(e.clientY - lastMY) > 4)) return;

  raycaster.setFromCamera(mouse, camera);

  const sphereHits = raycaster.intersectObject(sphere);
  if (sphereHits.length > 0) {
    showAbout();
    return;
  }

  const hits = raycaster.intersectObjects(cards);
  if (hits.length > 0) {
    const proj = hits[0].object.userData.project;
    openDetail(proj);
  }
});

/* Detail view */
function openDetail(proj) {
  const detailView = document.getElementById('detail-view');
  const detailTitle = document.getElementById('detail-title');
  const detailMeta = document.getElementById('detail-meta');
  const detailBody = document.getElementById('detail-body');
  const mainNav = document.getElementById('main-nav');

  detailTitle.textContent = proj.name;
  detailMeta.textContent = proj.count + (proj.count > 1 ? ' Images' : ' Image');

  const copy = PROJECT_COPY[proj.id] || { overview: '', contribution: '' };

  let html = '';
  if (proj.cover) {
    html += '<img class="detail-hero" src="projects/' + proj.cover + '" alt="">';
  }
  html += '<div class="detail-section"><h2>Project Overview</h2><p>' + (copy.overview || '') + '</p></div>';
  html += '<div class="detail-section"><h2>My Contribution</h2><p>' + (copy.contribution || '') + '</p></div>';

  if (proj.images && proj.images.length) {
    html += '<div class="detail-section"><h2>Gallery</h2><div class="detail-gallery">';
    proj.images.forEach((img, idx) => {
      html += '<img src="projects/' + img + '" alt="" onclick="openLightbox(' + idx + ')">';
    });
    html += '</div></div>';
  }

  detailBody.innerHTML = html;
  detailView.classList.add('active');
  container.classList.add('hidden');
  mainNav.classList.add('hidden');
  document.body.style.overflow = 'auto';

  window.currentProject = proj;
  window.currentImageIndex = 0;
}

window.backToSpace = function() {
  document.getElementById('detail-view').classList.remove('active');
  container.classList.remove('hidden');
  document.getElementById('main-nav').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
};

/* About overlay */
window.showAbout = function() {
  document.getElementById('about-overlay').classList.add('active');
  container.classList.add('hidden');
  document.getElementById('main-nav').classList.add('hidden');
  document.getElementById('hint').classList.add('hidden');
};

window.hideAbout = function() {
  document.getElementById('about-overlay').classList.remove('active');
  container.classList.remove('hidden');
  document.getElementById('main-nav').classList.remove('hidden');
};

/* Lightbox */
window.openLightbox = function(index) {
  const proj = window.currentProject;
  if (!proj || !proj.images.length) return;
  window.currentImageIndex = index;
  const lb = document.getElementById('lightbox');
  const img = document.getElementById('lightbox-img');
  img.src = 'projects/' + proj.images[index];
  document.getElementById('lb-counter').textContent = (index + 1) + ' / ' + proj.images.length;
  lb.classList.add('active');
};

window.closeLightbox = function() {
  document.getElementById('lightbox').classList.remove('active');
};

window.lbPrev = function() {
  const proj = window.currentProject;
  if (!proj) return;
  let i = window.currentImageIndex - 1;
  if (i < 0) i = proj.images.length - 1;
  openLightbox(i);
};

window.lbNext = function() {
  const proj = window.currentProject;
  if (!proj) return;
  let i = window.currentImageIndex + 1;
  if (i >= proj.images.length) i = 0;
  openLightbox(i);
};

document.addEventListener('keydown', (e) => {
  const lb = document.getElementById('lightbox');
  if (!lb.classList.contains('active')) return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowLeft') lbPrev();
  if (e.key === 'ArrowRight') lbNext();
});

/* Resize */
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

/* Animation loop */
const clock = new THREE.Clock();

function animate() {
  requestAnimationFrame(animate);
  const dt = clock.getDelta();

  /* Auto rotate when not dragging - calm, gallery-like drift */
  if (!isDragging) {
    targetT += 0.018 * dt;
  }

  /* Smooth camera - slower, more elegant transitions */
  camT += (targetT - camT) * 0.04;
  camP += (targetP - camP) * 0.04;
  updateCamera();

  /* Billboard label & cards always face camera */
  labelMesh.lookAt(camera.position);
  cards.forEach(c => c.lookAt(camera.position));

  /* Raycasting */
  raycaster.setFromCamera(mouse, camera);

  /* Sphere hover */
  const sphereHits = raycaster.intersectObject(sphere);
  if (sphereHits.length > 0 && !hoveredSphere) {
    hoveredSphere = true;
    document.body.style.cursor = 'pointer';
    tooltipTag.textContent = 'Resume';
    tooltipTitle.textContent = '刘子旭 · Event Producer';
    tooltipCount.textContent = 'Click to view';
    tooltip.classList.add('visible');
  } else if (sphereHits.length === 0 && hoveredSphere) {
    hoveredSphere = false;
    if (!hoveredCard) document.body.style.cursor = 'default';
    tooltip.classList.remove('visible');
  }

  /* Card hover */
  const hits = raycaster.intersectObjects(cards);
  if (hits.length > 0 && !hoveredSphere) {
    const hit = hits[0].object;
    if (hoveredCard !== hit) {
      if (hoveredCard) {
        hoveredCard.scale.set(1, 1, 1);
        hoveredCard.material.emissive = new THREE.Color(0x000000);
      }
      hoveredCard = hit;
      hoveredCard.scale.set(1.04, 1.04, 1.04);
      hoveredCard.material.emissive = new THREE.Color(0x444444);
      document.body.style.cursor = 'pointer';

      const proj = hit.userData.project;
      tooltipTag.textContent = 'Project';
      tooltipTitle.textContent = proj.name;
      tooltipCount.textContent = proj.count + (proj.count > 1 ? ' images' : ' image');
      tooltip.classList.add('visible');
    }
  } else if (hits.length === 0) {
    if (hoveredCard) {
      hoveredCard.scale.set(1, 1, 1);
      hoveredCard.material.emissive = new THREE.Color(0x000000);
      hoveredCard = null;
      if (!hoveredSphere) document.body.style.cursor = 'default';
      tooltip.classList.remove('visible');
    }
  }

  /* Tooltip follow mouse */
  if (tooltip.classList.contains('visible')) {
    let tx = mouseX + 18;
    let ty = mouseY + 18;
    if (tx + 280 > window.innerWidth) tx = mouseX - 290;
    if (ty + 100 > window.innerHeight) ty = mouseY - 100;
    tooltip.style.left = tx + 'px';
    tooltip.style.top = ty + 'px';
  }

  renderer.render(scene, camera);
}

animate();

} catch (err) {
  showError('Init Error: ' + (err.stack || err.message));
  document.getElementById('loading').classList.add('hidden');
}
</script>
</body>
